{
    "compilerOptions": {
        "target": "es6",
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": false,
        "module": "commonjs",
        "emitDeclarationOnly": true,
        "lib": ["es2017", "dom"],
        "types": ["node"],
        "declaration": true,
        "stripInternal": true
    }
}
